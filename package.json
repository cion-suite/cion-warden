{
    "name": "@cion-suite/warden",
    "version": "1.0.0",
    "packageManager": "pnpm@11.28.6",
    "engines": {
        "node": ">=24.15.0",
        "pnpm": ">=11.1.2"
    },
    "private": true,
    "description": "Warden of your macros - download, run, update. ",
    "license": "GPL-3.0-or-later",
    "author": "Cion Suite",
    "homepage": "https://github.com/cion-suite/cion-warden",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/cion-suite/cion-warden.git"
    },
    "bugs": {
        "url": "https://github.com/cion-suite/cion-warden/issues"
    },
    "type": "module",
    "main": "build/out/main/index.js",
    "scripts": {
        "dev": "install-electron && electron-vite dev",
        "build": "electron-vite build",
        "preview": "install-electron && electron-vite preview",
        "check:placeholders": "node scripts/check-placeholders.mjs",
        "dist": "pnpm check:placeholders && electron-vite build && electron-builder --config electron-builder.json --publish never",
        "typecheck:front": "tsc --noEmit -p tsconfig.front.json",
        "typecheck:back": "tsc --noEmit -p tsconfig.back.json",
        "typecheck": "tsc --noEmit -p tsconfig.front.json && tsc --noEmit -p tsconfig.back.json && tsc --noEmit -p tsconfig.node.json",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "ship": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
    },
    "dependencies": {
        "@cion-suite/core": "link:../cion-suite/packages/core",
        "electron-updater": "^6.8.9"
    },
    "devDependencies": {
        "@base-ui/react": "^1.9.0",
        "@eslint/js": "^10.0.1",
        "@fontsource-variable/geist": "^5.3.0",
        "@fontsource-variable/inter": "^5.3.0",
        "@shadcn/react": "^0.3.1",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-query": "^5.103.2",
        "@types/node": "^24.13.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/semver": "^7.8.0",
        "@vitejs/plugin-react": "^5.2.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.4.0",
        "date-fns": "^4.4.0",
        "electron": "^44.4.3",
        "electron-builder": "^26.16.1",
        "electron-vite": "^5.0.0",
        "embla-carousel-react": "^8.6.0",
        "eslint": "^10.11.0",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-boundaries": "^6.0.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.13.0",
        "i18next": "^26.4.2",
        "input-otp": "^1.5.0",
        "lucide-react": "^1.47.0",
        "react": "^19.3.0",
        "react-day-picker": "^10.0.2",
        "react-dom": "^19.3.0",
        "react-error-boundary": "^6.1.6",
        "react-i18next": "^17.0.15",
        "react-markdown": "^10.1.0",
        "react-resizable-panels": "^4.14.3",
        "react-router-dom": "^7.18.4",
        "recharts": "3.8.0",
        "remark-gfm": "^4.0.1",
        "semver": "^7.8.5",
        "shadcn": "^4.21.4",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.70.1",
        "vaul": "^1.1.2",
        "vite": "^7.3.6",
        "vitest": "^4.1.11",
        "zod": "4.6.5"
    }
}
