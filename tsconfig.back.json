{
    "compilerOptions": {
        "paths": {
            "@app/*": ["./app/*"],
            "@shared/*": ["./shared/*"]
        },
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.back.tsbuildinfo",
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "ESNext",
        "types": ["node"],
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "moduleDetection": "force",
        "noEmit": true,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "erasableSyntaxOnly": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedSideEffectImports": true
    },
    "include": ["app", "shared", "tests/app", "tests/shared", "tests/support"]
}
